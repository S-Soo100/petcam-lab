{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tera-ai.uk/schemas/research-run-manifest-v1.json",
  "title": "RBA Research Run Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "objective",
    "source",
    "runtime",
    "model",
    "authorization",
    "data",
    "budget",
    "safety",
    "stop_conditions",
    "deliverables"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F\\u007F-\\u009F])\\S(?:[\\s\\S]*\\S)?$"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F\\u007F-\\u009F])\\S(?:[\\s\\S]*\\S)?$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_repo",
        "branch",
        "commit_sha",
        "start_manifest_commit_sha",
        "final_commit_sha",
        "design_path",
        "plan_path",
        "require_clean"
      ],
      "properties": {
        "execution_repo": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/(?![\\s\\S]*[\\u0000-\\u001F\\u007F-\\u009F])(?:[\\s\\S]*\\S)?$"
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F\\u007F-\\u009F])\\S(?:[\\s\\S]*\\S)?$"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "start_manifest_commit_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "final_commit_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "design_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/(?![\\s\\S]*[\\u0000-\\u001F\\u007F-\\u009F])(?:[\\s\\S]*\\S)?$"
        },
        "plan_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/(?![\\s\\S]*[\\u0000-\\u001F\\u007F-\\u009F])(?:[\\s\\S]*\\S)?$"
        },
        "require_clean": {
          "const": true
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_host",
        "runtime_kind",
        "runtime_host",
        "runtime_label"
      ],
      "properties": {
        "implementation_host": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F\\u007F-\\u009F])\\S(?:[\\s\\S]*\\S)?$"
        },
        "runtime_kind": {
          "enum": [
            "none",
            "oneshot",
            "launchagent",
            "server",
            "scheduled-job",
            "mobile-build"
          ]
        },
        "runtime_host": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F\\u007F-\\u009F])\\S(?:[\\s\\S]*\\S)?$"
        },
        "runtime_label": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F\\u007F-\\u009F])\\S(?:[\\s\\S]*\\S)?$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "runtime_kind": {
                "const": "none"
              }
            },
            "required": [
              "runtime_kind"
            ]
          },
          "then": {
            "properties": {
              "runtime_host": {
                "const": null
              },
              "runtime_label": {
                "const": null
              }
            }
          },
          "else": {
            "properties": {
              "runtime_host": {
                "type": "string"
              },
              "runtime_label": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "surface",
        "requested_model",
        "requested_reasoning",
        "actual_model",
        "actual_reasoning",
        "fallback_reason"
      ],
      "properties": {
        "profile": {
          "enum": [
            "frontier_planning",
            "critical_engineering",
            "standard_execution",
            "independent_review",
            "local_assistant"
          ]
        },
        "surface": {
          "enum": [
            "desktop",
            "cli",
            "api",
            "local"
          ]
        },
        "requested_model": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F\\u007F-\\u009F])\\S(?:[\\s\\S]*\\S)?$"
        },
        "requested_reasoning": {
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "ultra",
            "unverified"
          ]
        },
        "actual_model": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F\\u007F-\\u009F])\\S(?:[\\s\\S]*\\S)?$"
        },
        "actual_reasoning": {
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "ultra",
            "unverified",
            null
          ]
        },
        "fallback_reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F\\u007F-\\u009F])\\S(?:[\\s\\S]*\\S)?$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "actual_model": {
                "const": null
              }
            },
            "required": [
              "actual_model"
            ]
          },
          "then": {
            "properties": {
              "actual_reasoning": {
                "const": null
              },
              "fallback_reason": {
                "const": null
              }
            }
          },
          "else": {
            "properties": {
              "actual_reasoning": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "actual_reasoning": {
                "const": null
              }
            },
            "required": [
              "actual_reasoning"
            ]
          },
          "then": {
            "properties": {
              "actual_model": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "actual_model": {
                "const": "unverified"
              },
              "actual_reasoning": {
                "const": "unverified"
              }
            },
            "required": [
              "actual_model",
              "actual_reasoning"
            ]
          },
          "then": {
            "properties": {
              "fallback_reason": {
                "const": null
              }
            }
          }
        }
      ]
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_by",
        "approved_at",
        "max_permission",
        "allowed_actions",
        "p3_targets",
        "p4_actions"
      ],
      "properties": {
        "approved_by": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F\\u007F-\\u009F])\\S(?:[\\s\\S]*\\S)?$"
        },
        "approved_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F\\u007F-\\u009F])[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])(?![\\s\\S])"
        },
        "max_permission": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3",
            "P4"
          ]
        },
        "allowed_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "docs_write",
              "local_code_write",
              "feature_branch_commit",
              "feature_branch_push",
              "preview_deploy",
              "disposable_db",
              "rollback_probe",
              "nonproduction_canary",
              "production_migration",
              "production_deploy",
              "runtime_service_write",
              "database_delete",
              "r2_delete",
              "destructive_git",
              "credential_change",
              "cost_limit_increase"
            ]
          }
        },
        "p3_targets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "target",
              "rollback",
              "canary"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "production_migration",
                  "production_deploy",
                  "runtime_service_write"
                ]
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F\\u007F-\\u009F])\\S(?:[\\s\\S]*\\S)?$"
              },
              "rollback": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F\\u007F-\\u009F])\\S(?:[\\s\\S]*\\S)?$"
              },
              "canary": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F\\u007F-\\u009F])\\S(?:[\\s\\S]*\\S)?$"
              }
            }
          }
        },
        "p4_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "target",
              "approval_ref"
            ],
            "properties": {
              "action": {
                "enum": [
                  "database_delete",
                  "r2_delete",
                  "destructive_git",
                  "credential_change",
                  "cost_limit_increase"
                ]
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F\\u007F-\\u009F])\\S(?:[\\s\\S]*\\S)?$"
              },
              "approval_ref": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F\\u007F-\\u009F])\\S(?:[\\s\\S]*\\S)?$"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "max_permission": {
                "const": "P0"
              }
            },
            "required": [
              "max_permission"
            ]
          },
          "then": {
            "properties": {
              "allowed_actions": {
                "maxItems": 0
              },
              "p3_targets": {
                "maxItems": 0
              },
              "p4_actions": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "max_permission": {
                "const": "P1"
              }
            },
            "required": [
              "max_permission"
            ]
          },
          "then": {
            "properties": {
              "allowed_actions": {
                "items": {
                  "enum": [
                    "docs_write",
                    "local_code_write",
                    "feature_branch_commit",
                    "feature_branch_push"
                  ]
                }
              },
              "p3_targets": {
                "maxItems": 0
              },
              "p4_actions": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "max_permission": {
                "const": "P2"
              }
            },
            "required": [
              "max_permission"
            ]
          },
          "then": {
            "properties": {
              "allowed_actions": {
                "items": {
                  "enum": [
                    "docs_write",
                    "local_code_write",
                    "feature_branch_commit",
                    "feature_branch_push",
                    "preview_deploy",
                    "disposable_db",
                    "rollback_probe",
                    "nonproduction_canary"
                  ]
                }
              },
              "p3_targets": {
                "maxItems": 0
              },
              "p4_actions": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "max_permission": {
                "const": "P3"
              }
            },
            "required": [
              "max_permission"
            ]
          },
          "then": {
            "properties": {
              "allowed_actions": {
                "items": {
                  "not": {
                    "enum": [
                      "database_delete",
                      "r2_delete",
                      "destructive_git",
                      "credential_change",
                      "cost_limit_increase"
                    ]
                  }
                }
              },
              "p4_actions": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_version",
        "splits",
        "privacy_class",
        "media_contract"
      ],
      "properties": {
        "dataset_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F\\u007F-\\u009F])\\S(?:[\\s\\S]*\\S)?$"
        },
        "splits": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F\\u007F-\\u009F])\\S(?:[\\s\\S]*\\S)?$"
          }
        },
        "privacy_class": {
          "enum": [
            "public",
            "internal",
            "sensitive"
          ]
        },
        "media_contract": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F\\u007F-\\u009F])\\S(?:[\\s\\S]*\\S)?$"
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_provider_calls",
        "max_cost_krw",
        "max_wall_minutes",
        "deadline"
      ],
      "properties": {
        "max_provider_calls": {
          "type": "integer",
          "minimum": 0
        },
        "max_cost_krw": {
          "type": "number",
          "minimum": 0
        },
        "max_wall_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "deadline": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F\\u007F-\\u009F])[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])(?![\\s\\S])"
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requires_host_guard",
        "requires_lock",
        "requires_rollback",
        "requires_residue_zero",
        "temp_media_must_be_zero"
      ],
      "properties": {
        "requires_host_guard": {
          "type": "boolean"
        },
        "requires_lock": {
          "type": "boolean"
        },
        "requires_rollback": {
          "type": "boolean"
        },
        "requires_residue_zero": {
          "type": "boolean"
        },
        "temp_media_must_be_zero": {
          "type": "boolean"
        }
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F\\u007F-\\u009F])\\S(?:[\\s\\S]*\\S)?$"
      }
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F\\u007F-\\u009F])\\S(?:[\\s\\S]*\\S)?$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "authorization": {
            "properties": {
              "allowed_actions": {
                "contains": {
                  "enum": [
                    "production_migration",
                    "production_deploy",
                    "runtime_service_write"
                  ]
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "safety": {
            "properties": {
              "requires_rollback": {
                "const": true
              },
              "requires_residue_zero": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "authorization": {
            "properties": {
              "allowed_actions": {
                "contains": {
                  "const": "runtime_service_write"
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "safety": {
            "properties": {
              "requires_host_guard": {
                "const": true
              },
              "requires_lock": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "authorization": {
            "properties": {
              "allowed_actions": {
                "contains": {
                  "const": "disposable_db"
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "safety": {
            "properties": {
              "requires_residue_zero": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "authorization": {
            "properties": {
              "allowed_actions": {
                "contains": {
                  "const": "rollback_probe"
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "safety": {
            "properties": {
              "requires_rollback": {
                "const": true
              },
              "requires_residue_zero": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
